{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "lib": ["DOM", "ES2020", "WebWorker"],
    "outDir": "./dist",
    "paths": {
      "three": ["node_modules/three/src/Three.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "main.ts"]
}
